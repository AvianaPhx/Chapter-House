  "components": {
    "schemas": {
      "AddBookDto": {
        "required": [
          "author",
          "formatId",
          "genreId",
          "isbn",
          "publisherId",
          "stock",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "author": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "isbn": {
            "maxLength": 13,
            "minLength": 13,
            "type": "string",
            "nullable": true
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          },
          "onSale": {
            "type": "boolean"
          },
          "published": {
            "type": "string",
            "format": "date-time"
          },
          "discountedPrice": {
            "type": "number",
            "format": "double"
          },
          "genreId": {
            "type": "integer",
            "format": "int32"
          },
          "formatId": {
            "type": "integer",
            "format": "int32"
          },
          "publisherId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AddGenreDto": {
        "required": [
          "genreName"
        ],
        "type": "object",
        "properties": {
          "genreName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AddPublisherDto": {
        "required": [
          "publisherName"
        ],
        "type": "object",
        "properties": {
          "publisherName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Role": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "SignInRequest": {
        "required": [
          "email",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "additionalProperties": false
      },
      "SignUpRequest": {
        "required": [
          "confirmPassword",
          "email",
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          },
          "confirmPassword": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateBookDto": {
        "required": [
          "author",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "author": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpdateGenreDto": {
        "required": [
          "genreName"
        ],
        "type": "object",
        "properties": {
          "genreName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdatePublisherDto": {
        "required": [
